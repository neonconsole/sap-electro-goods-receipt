*&---------------------------------------------------------------------*
*& Report ZKOF6_R_MAIN
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT zkof6_r_main.

INCLUDE zkof6_r_main_top.
INCLUDE zkof6_r_main_status_0200o01.
INCLUDE zkof6_r_main_user_command_0i01.
INCLUDE zkof6_r_main_f01.

SELECTION-SCREEN BEGIN OF BLOCK b01 WITH FRAME TITLE TEXT-t04.
  SELECTION-SCREEN SKIP.
  SELECTION-SCREEN PUSHBUTTON /1(20) TEXT-t01 USER-COMMAND recv VISIBLE LENGTH 20.
  SELECTION-SCREEN SKIP.
  SELECTION-SCREEN PUSHBUTTON /1(20) TEXT-t02 USER-COMMAND stat VISIBLE LENGTH 20.
  SELECTION-SCREEN SKIP.
  SELECTION-SCREEN PUSHBUTTON /1(20) TEXT-t03 USER-COMMAND adm VISIBLE LENGTH 20.
  SELECTION-SCREEN SKIP.
SELECTION-SCREEN END OF BLOCK b01.

SELECTION-SCREEN BEGIN OF SCREEN 0300.
  SELECTION-SCREEN BEGIN OF BLOCK b02 WITH FRAME TITLE TEXT-t05.
    SELECTION-SCREEN SKIP.
    SELECTION-SCREEN PUSHBUTTON /1(20) TEXT-t06 USER-COMMAND order VISIBLE LENGTH 20.
    SELECTION-SCREEN SKIP.
    SELECTION-SCREEN PUSHBUTTON /1(20) TEXT-t07 USER-COMMAND order_i VISIBLE LENGTH 20.
    SELECTION-SCREEN SKIP.
    SELECTION-SCREEN PUSHBUTTON /1(20) TEXT-t08 USER-COMMAND prod VISIBLE LENGTH 20.
    SELECTION-SCREEN SKIP.
    SELECTION-SCREEN PUSHBUTTON /1(20) TEXT-t09 USER-COMMAND manu VISIBLE LENGTH 20.
    SELECTION-SCREEN SKIP.
    SELECTION-SCREEN PUSHBUTTON /1(20) TEXT-t10 USER-COMMAND back VISIBLE LENGTH 20.
    SELECTION-SCREEN SKIP.
  SELECTION-SCREEN END OF BLOCK b02.
SELECTION-SCREEN END OF SCREEN 0300.

AT SELECTION-SCREEN.

  CASE sy-dynnr.

    WHEN '1000'.

      CASE sscrfields-ucomm.
        WHEN 'RECV'.
          CALL SCREEN 0200.
        WHEN 'STAT'.
          SUBMIT zkof6_r_status VIA SELECTION-SCREEN AND RETURN.
        WHEN 'ADM'.
          CALL SELECTION-SCREEN 0300.
      ENDCASE.

    WHEN '0300'.

      CASE sscrfields-ucomm.
        WHEN 'ORDER'.
          PERFORM call_maintenance_view USING 'ZKOF6_D_ORDER_H'.

        WHEN 'ORDER_I'.
          PERFORM call_maintenance_view USING 'ZKOF6_D_ORDER_I'.

        WHEN 'PROD'.
          PERFORM call_maintenance_view USING 'ZKOF6_V_PRODUCT'.

        WHEN 'MANU'.
          PERFORM call_maintenance_view USING 'ZKOF6_D_MANUFACT'.

        WHEN 'BACK'.
          LEAVE TO SCREEN 0.

      ENDCASE.

  ENDCASE.

INCLUDE zkof6_r_main_f4_product_nami01.
