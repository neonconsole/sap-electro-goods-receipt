*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZKOF6_V_PRODUCT.................................*
FORM GET_DATA_ZKOF6_V_PRODUCT.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZKOF6_D_PRODUCT WHERE
(VIM_WHERETAB) .
    CLEAR ZKOF6_V_PRODUCT .
ZKOF6_V_PRODUCT-MANDT =
ZKOF6_D_PRODUCT-MANDT .
ZKOF6_V_PRODUCT-PRODUCT_ID =
ZKOF6_D_PRODUCT-PRODUCT_ID .
ZKOF6_V_PRODUCT-MANUFACTURER_ID =
ZKOF6_D_PRODUCT-MANUFACTURER_ID .
ZKOF6_V_PRODUCT-UNIT =
ZKOF6_D_PRODUCT-UNIT .
ZKOF6_V_PRODUCT-WAREHOUSE_TYPE =
ZKOF6_D_PRODUCT-WAREHOUSE_TYPE .
    SELECT SINGLE * FROM ZKOF6_D_PROD_T WHERE
PRODUCT_ID = ZKOF6_D_PRODUCT-PRODUCT_ID AND
LANGU = SY-LANGU .
    IF SY-SUBRC EQ 0.
ZKOF6_V_PRODUCT-PRODUCT_NAME =
ZKOF6_D_PROD_T-PRODUCT_NAME .
ZKOF6_V_PRODUCT-DESCRIPTION =
ZKOF6_D_PROD_T-DESCRIPTION .
    ENDIF.
<VIM_TOTAL_STRUC> = ZKOF6_V_PRODUCT.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZKOF6_V_PRODUCT .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZKOF6_V_PRODUCT.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZKOF6_V_PRODUCT-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZKOF6_D_PRODUCT WHERE
  PRODUCT_ID = ZKOF6_V_PRODUCT-PRODUCT_ID .
    IF SY-SUBRC = 0.
    DELETE ZKOF6_D_PRODUCT .
    ENDIF.
    DELETE FROM ZKOF6_D_PROD_T WHERE
    PRODUCT_ID = ZKOF6_D_PRODUCT-PRODUCT_ID .
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZKOF6_D_PRODUCT WHERE
  PRODUCT_ID = ZKOF6_V_PRODUCT-PRODUCT_ID .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZKOF6_D_PRODUCT.
    ENDIF.
ZKOF6_D_PRODUCT-MANDT =
ZKOF6_V_PRODUCT-MANDT .
ZKOF6_D_PRODUCT-PRODUCT_ID =
ZKOF6_V_PRODUCT-PRODUCT_ID .
ZKOF6_D_PRODUCT-MANUFACTURER_ID =
ZKOF6_V_PRODUCT-MANUFACTURER_ID .
ZKOF6_D_PRODUCT-UNIT =
ZKOF6_V_PRODUCT-UNIT .
ZKOF6_D_PRODUCT-WAREHOUSE_TYPE =
ZKOF6_V_PRODUCT-WAREHOUSE_TYPE .
    IF SY-SUBRC = 0.
    UPDATE ZKOF6_D_PRODUCT ##WARN_OK.
    ELSE.
    INSERT ZKOF6_D_PRODUCT .
    ENDIF.
    SELECT SINGLE FOR UPDATE * FROM ZKOF6_D_PROD_T WHERE
    PRODUCT_ID = ZKOF6_D_PRODUCT-PRODUCT_ID AND
    LANGU = SY-LANGU .
      IF SY-SUBRC <> 0.   "insert preprocessing: init WA
        CLEAR ZKOF6_D_PROD_T.
ZKOF6_D_PROD_T-PRODUCT_ID =
ZKOF6_D_PRODUCT-PRODUCT_ID .
ZKOF6_D_PROD_T-LANGU =
SY-LANGU .
      ENDIF.
ZKOF6_D_PROD_T-PRODUCT_NAME =
ZKOF6_V_PRODUCT-PRODUCT_NAME .
ZKOF6_D_PROD_T-DESCRIPTION =
ZKOF6_V_PRODUCT-DESCRIPTION .
    IF SY-SUBRC = 0.
    UPDATE ZKOF6_D_PROD_T ##WARN_OK.
    ELSE.
    INSERT ZKOF6_D_PROD_T .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZKOF6_V_PRODUCT-UPD_FLAG,
STATUS_ZKOF6_V_PRODUCT-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
*---------------------------------------------------------------------*
FORM READ_SINGLE_ZKOF6_V_PRODUCT.
  SELECT SINGLE * FROM ZKOF6_D_PRODUCT WHERE
PRODUCT_ID = ZKOF6_V_PRODUCT-PRODUCT_ID .
ZKOF6_V_PRODUCT-MANDT =
ZKOF6_D_PRODUCT-MANDT .
ZKOF6_V_PRODUCT-PRODUCT_ID =
ZKOF6_D_PRODUCT-PRODUCT_ID .
ZKOF6_V_PRODUCT-MANUFACTURER_ID =
ZKOF6_D_PRODUCT-MANUFACTURER_ID .
ZKOF6_V_PRODUCT-UNIT =
ZKOF6_D_PRODUCT-UNIT .
ZKOF6_V_PRODUCT-WAREHOUSE_TYPE =
ZKOF6_D_PRODUCT-WAREHOUSE_TYPE .
    SELECT SINGLE * FROM ZKOF6_D_PROD_T WHERE
PRODUCT_ID = ZKOF6_D_PRODUCT-PRODUCT_ID AND
LANGU = SY-LANGU .
    IF SY-SUBRC EQ 0.
ZKOF6_V_PRODUCT-PRODUCT_NAME =
ZKOF6_D_PROD_T-PRODUCT_NAME .
ZKOF6_V_PRODUCT-DESCRIPTION =
ZKOF6_D_PROD_T-DESCRIPTION .
    ELSE.
      CLEAR SY-SUBRC.
      CLEAR ZKOF6_V_PRODUCT-PRODUCT_NAME .
      CLEAR ZKOF6_V_PRODUCT-DESCRIPTION .
    ENDIF.
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZKOF6_V_PRODUCT USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZKOF6_V_PRODUCT-PRODUCT_ID TO
ZKOF6_D_PRODUCT-PRODUCT_ID .
MOVE ZKOF6_V_PRODUCT-MANDT TO
ZKOF6_D_PRODUCT-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZKOF6_D_PRODUCT'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZKOF6_D_PRODUCT TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZKOF6_D_PRODUCT'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

MOVE ZKOF6_D_PRODUCT-PRODUCT_ID TO
ZKOF6_D_PROD_T-PRODUCT_ID .
MOVE SY-LANGU TO
ZKOF6_D_PROD_T-LANGU .
MOVE ZKOF6_V_PRODUCT-MANDT TO
ZKOF6_D_PROD_T-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZKOF6_D_PROD_T'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZKOF6_D_PROD_T TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZKOF6_D_PROD_T'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
